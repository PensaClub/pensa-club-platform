  "hero": {
    "title": "DECENT LIFE FOR PEOPLE IN THE THIRD AGE",
    "desc": "Bulgaria is the country in the European Union (EU) in which the <span>elderly</span> are most threatened by poverty, social exclusion and material difficulties, according to data from the European statistical service Eurostat. <span>Bulgarian pensioners</span> are also the most isolated from the Internet in the EU. Only one in ten people uses the web, and half of those who have internet access write e-mails, read news and search for information about goods. Only <span>2%</span> of them shop online, and every third uses on social networks.",
    "testimonials": {
      "first-revolution-title": "First Industrial Revolution",
      "first-revolution-desc": "It is distinguished by the introduction of the steam engine, which led to the mechanization of production and the development of the railway transport.",
      "second-revolution-title": "Second Industrial Revolution",
      "second-revolution-desc": "It was characterized by the widespread spread of electricity and power lines, which increased production efficiency and stimulated industrial growth.",
      "third-revolution-title": "Third Industrial Revolution",
      "third-revolution-desc": "Also called the Digital Revolution, this era was marked by the introduction of computers, the Internet and automation, which radically changed the way production processes were managed and controlled.",
      "forth-revolution-title": "Revolution 4.0",
      "forth-revolution-desc": "Focused on smart factories that use the Internet of Things (IoT), automated decision making and machine learning to further increase manufacturing efficiency.",
      "fifth-revolution-title": "Revolution 5.0",
      "fifth-revolution-desc": "This is the latest stage in the development, which involves the use of artificial intelligence not only for automation, but also for the integration of human creative and analytical potential"
    }
  },
  "motto": {
    "title1": "LET'S BREAK THIS TREND",
    "title2": "LET'S CHANGE THIS MODEL",
    "title3": "KEEPING UP WITH THE TIMES",
    "desc": "This is an innovative platform, a <span>tool</span> for creating a community. A community of people of the same age, with similar interests, new ideas, and new knowledge. A community for interaction and mutual support. The expected outcome is an improvement in <span>quality of life</span>, through <span>active engagement</span> in contemporary life, support for <span>new skills</span> and interests, and encouragement towards a <span>healthy and fulfilling, dignified life</span>!",
